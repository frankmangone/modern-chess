# Copy to apps/game-api/.env, or run `make dev-keys` to create it with a development key.
# Start the database with `make db-up`.
DATABASE_URL=postgres://modern_chess:modern_chess@localhost:5455/game
API_HOST=127.0.0.1
API_PORT=3001
DATABASE_MIGRATE_ON_STARTUP=true
RUST_LOG=modern_chess_game_api=info,info
# AUTH_PUBLIC_KEY_PEM is the public half of social-api's key, on one line with \n for line breaks.
