# Copy to apps/social-api/.env, or run `make dev-keys` to create it with a development key.
# Start the database with `make db-up`.
DATABASE_URL=postgres://modern_chess:modern_chess@localhost:5455/social
API_HOST=127.0.0.1
API_PORT=3002
DATABASE_MIGRATE_ON_STARTUP=true
RUST_LOG=modern_chess_social_api=info,info
# SOCIAL_SIGNING_KEY_PEM is this app's private key: it never leaves this app's environment.

# Signing in with an outside provider (Clerk). Leave these out and only guests can sign in.
# Nothing here is a secret: the app checks tokens with the provider's public keys.
# SOCIAL_PROVIDER_NAME=clerk
# SOCIAL_PROVIDER_ISSUER=https://<your-instance>.clerk.accounts.dev
# Defaults to <issuer>/.well-known/jwks.json
# SOCIAL_PROVIDER_JWKS_URL=
# Origins allowed to ask for a token, comma separated; empty means any. One * stands for one
# host label. Never list a domain that anyone can get a subdomain of (like a free tunnel
# service): that allows everyone. For `make share`, leave this empty.
# SOCIAL_PROVIDER_AUTHORIZED_PARTIES=http://localhost:5173,https://play.example.com
