# Copy to apps/social-api/.env, or run `make dev-keys` to create it with a development key.
# Start the database with `make db-up`.
DATABASE_URL=postgres://modern_chess:modern_chess@localhost:5455/social
API_HOST=127.0.0.1
API_PORT=3002
DATABASE_MIGRATE_ON_STARTUP=true
RUST_LOG=modern_chess_social_api=info,info
# SOCIAL_SIGNING_KEY_PEM is this app's private key: it never leaves this app's environment.
